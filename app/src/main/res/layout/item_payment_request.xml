<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/login_input_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Ícone de status (troque o background por bg_status_confirmed no código) -->
        <FrameLayout
            android:id="@+id/boxStatus"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_status_pending">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Status"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/login_hint"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="16/07/2026" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/login_black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="A confirmar" />

                <TextView
                    android:id="@+id/tvValor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/login_black"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="R$ 1200" />
            </LinearLayout>
        </LinearLayout>

        <!-- Só aparece nos requerimentos pendentes -->
        <ImageView
            android:id="@+id/btnRemover"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="8dp"
            android:clickable="true"
            android:contentDescription="Cancelar requerimento"
            android:focusable="true"
            android:src="@drawable/ic_remove_circle"
            app:tint="@color/payment_remove" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
