<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_screen_bg"
    android:padding="16dp"
    tools:context=".RegisterActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_card"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="56dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Crie sua conta"
                android:textColor="@color/login_black"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="Endereço de E-mail"
                android:textColor="@color/login_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_mail"
                android:drawablePadding="12dp"
                android:drawableTint="@color/login_black"
                android:hint="Digite seu email"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/login_text"
                android:textColorHint="@color/login_hint"
                android:textSize="14sp" />

            <!-- Senha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Senha"
                android:textColor="@color/login_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSenha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="newPassword"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawableEnd="@drawable/ic_visibility"
                android:drawablePadding="12dp"
                android:drawableTint="@color/login_black"
                android:hint="Digite sua senha"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/login_text"
                android:textColorHint="@color/login_hint"
                android:textSize="14sp" />

            <!-- Confirmar senha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Confirm Password"
                android:textColor="@color/login_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Para o estado de erro, troque o background no código por @drawable/bg_input_error -->
            <EditText
                android:id="@+id/etConfirmaSenha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="newPassword"
                android:background="@drawable/bg_input_error"
                android:drawableStart="@drawable/ic_lock"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="12dp"
                android:drawableTint="@color/login_black"
                android:hint="Confirme sua senha"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/login_text"
                android:textColorHint="@color/login_hint"
                android:textSize="14sp" />

            <!-- Caixa de erro -->
            <LinearLayout
                android:id="@+id/boxErro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_error_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Erro"
                    android:src="@drawable/ic_error" />

                <TextView
                    android:id="@+id/tvErro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="ERRO: Senhas não são iguais!"
                    android:textColor="@color/login_error_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Botão -->
            <Button
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:drawableTint="@color/white"
                android:paddingHorizontal="90dp"
                android:text="Cadastrar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Rodapé -->
            <TextView
                android:id="@+id/tvJaTemConta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:padding="4dp"
                android:text="Já possui uma conta? Entre."
                android:textColor="@color/login_footer"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
