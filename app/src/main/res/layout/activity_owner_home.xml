<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_screen_bg"
    android:padding="12dp"
    tools:context=".OwnerHomeActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Cabeçalho -->
            <TextView
                android:id="@+id/tvBoasVindas"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@drawable/bg_header"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="Hello, Eren"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Acesse as áreas"
                android:textColor="@color/login_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Cards de status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPendentes"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/login_input_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_margin="6dp"
                        android:contentDescription="Pendentes"
                        android:src="@drawable/ic_payments"
                        app:tint="#2E9E4F" />

                    <TextView
                        android:id="@+id/tvPendentes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="9"
                        android:textColor="@color/login_black"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="6dp"
                        android:gravity="center"
                        android:text="Pendentes"
                        android:textColor="@color/login_hint"
                        android:textSize="10sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRendaProjetada"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1.7"
                    app:cardBackgroundColor="@color/login_input_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tvRendaProjetada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="R$ 12.054"
                        android:textColor="@color/login_black"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="6dp"
                        android:gravity="center"
                        android:text="Renda Projetada"
                        android:textColor="@color/login_hint"
                        android:textSize="10sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Atalhos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnFinanceiro"
                    android:layout_width="60dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/login_input_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="Financeiro"
                        android:src="@drawable/ic_payments"
                        app:tint="@color/login_black" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnQrCode"
                    android:layout_width="60dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/login_input_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="QR Code"
                        android:src="@drawable/ic_qr_code"
                        app:tint="@color/login_black" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnManutencao"
                    android:layout_width="60dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/login_input_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="Manutenção"
                        android:src="@drawable/ic_build"
                        app:tint="@color/login_black" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Botão flutuante (imóvel) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnImovel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/login_input_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Imóvel"
                android:src="@drawable/ic_home"
                app:tint="@color/login_black" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</FrameLayout>
